{
  "name": "strengames-hub",
  "private": true,
  "description": "StrenGames Hub: Google Apps Script web app for the six-week Strenuous Life competition",
  "scripts": {
    "test": "node --test test/logic.test.js test/server.test.js test/scoring-regression.test.js",
    "test:e2e": "node --test test/e2e.test.js",
    "demo": "node test/build-preview.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "eslint": "10.14.0",
    "globals": "17.14.0",
    "husky": "9.1.7",
    "lint-staged": "17.6.1",
    "playwright": "1.63.0",
    "prettier": "3.10.1"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
